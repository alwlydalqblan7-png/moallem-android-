package __APP_PACKAGE__;

import android.app.PendingIntent;
import android.appwidget.AppWidgetManager;
import android.appwidget.AppWidgetProvider;
import android.content.ComponentName;
import android.content.Context;
import android.content.Intent;
import android.content.SharedPreferences;
import android.os.Build;
import android.text.format.DateFormat;
import android.widget.RemoteViews;
import org.json.JSONArray;

import java.util.Calendar;

public class HomeWidgetProvider extends AppWidgetProvider {
    private static final String[] DAYS = {"", "الأحد", "الإثنين", "الثلاثاء", "الأربعاء", "الخميس", "الجمعة", "السبت"};

    @Override
    public void onUpdate(Context context, AppWidgetManager manager, int[] ids) {
        for (int id : ids) updateOne(context, manager, id);
    }

    public static void updateAll(Context context) {
        AppWidgetManager manager = AppWidgetManager.getInstance(context);
        int[] ids = manager.getAppWidgetIds(new ComponentName(context, HomeWidgetProvider.class));
        for (int id : ids) updateOne(context, manager, id);
    }

    private static void updateOne(Context context, AppWidgetManager manager, int id) {
        Calendar now = Calendar.getInstance();
        String dayName = DAYS[now.get(Calendar.DAY_OF_WEEK)];
        String dayLabel = dayName + " · " + DateFormat.format("d/M", now);
        String status = calculateStatus(context, now);

        RemoteViews views = new RemoteViews(context.getPackageName(), R.layout.moallem_widget);
        views.setTextViewText(R.id.widget_status, status);
        views.setTextViewText(R.id.widget_day, dayLabel);
        Intent launch = new Intent(context, MainActivity.class);
        launch.setFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_CLEAR_TOP);
        int flags = PendingIntent.FLAG_UPDATE_CURRENT;
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) flags |= PendingIntent.FLAG_IMMUTABLE;
        PendingIntent pending = PendingIntent.getActivity(context, 471, launch, flags);
        views.setOnClickPendingIntent(R.id.widget_root, pending);
        manager.updateAppWidget(id, views);
    }

    private static String calculateStatus(Context context, Calendar now) {
        int day = now.get(Calendar.DAY_OF_WEEK);
        if (day == Calendar.FRIDAY || day == Calendar.SATURDAY) return "عطلة نهاية الأسبوع";

        SharedPreferences prefs = context.getSharedPreferences("moallem_widget", Context.MODE_PRIVATE);
        JSONArray periods;
        try {
            periods = new JSONArray(prefs.getString("periods", "[]"));
        } catch (Exception error) {
            periods = new JSONArray();
        }
        if (periods.length() == 0) return "افتح التطبيق لمزامنة الجدول";
        int current = now.get(Calendar.HOUR_OF_DAY) * 60 + now.get(Calendar.MINUTE);
        int nextIndex = -1;
        int nextStart = -1;
        for (int i = 0; i < periods.length(); i++) {
            JSONArray period = periods.optJSONArray(i);
            if (period == null) continue;
            int start = parseTime(period.optString(0));
            int end = parseTime(period.optString(1));
            if (start < 0 || end <= start) continue;
            if (current < start) {
                nextIndex = i;
                nextStart = start;
                break;
            }
            if (current < end) return "الحصة " + (i + 1) + " الآن";
        }
        if (nextIndex >= 0) {
            String time = String.format(java.util.Locale.getDefault(), "%02d:%02d", nextStart / 60, nextStart % 60);
            return nextIndex == 0 ? "تبدأ حصتك الأولى الساعة " + time : "استراحة — الحصة " + (nextIndex + 1) + " الساعة " + time;
        }
        return "انتهت حصصك اليوم";
    }

    private static int parseTime(String value) {
        if (value == null || !value.matches("([01]\\d|2[0-3]):[0-5]\\d")) return -1;
        String[] parts = value.split(":");
        return Integer.parseInt(parts[0]) * 60 + Integer.parseInt(parts[1]);
    }
}
