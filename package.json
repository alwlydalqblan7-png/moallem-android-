{
  "name": "moallem-v2",
  "version": "2.6.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "android:add": "npx cap add android",
    "android:sync": "npm run build && npx cap sync android && node scripts/prepare-android.mjs",
    "android:open": "npx cap open android",
    "test": "node --test tests/*.test.js",
    "test:app": "node --test tests/app.test.js",
    "test:worker": "node --test tests/worker.test.js",
    "desktop:start": "electron desktop/main.cjs",
    "desktop:dir": "vite build --base=./ && electron-builder --dir --win",
    "desktop:win": "vite build --base=./ && electron-builder --win nsis portable"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.taifdigital.moallem.desktop",
    "productName": "معلّم للكمبيوتر",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "desktop/**/*", "package.json"],
    "asar": true,
    "artifactName": "Moallem-Desktop-${version}-${arch}.${ext}",
    "win": {
      "icon": "assets/moallem-icon.ico",
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.4.3",
    "@capacitor/local-notifications": "^7.0.7",
    "@capgo/capacitor-printer": "^7.0.0",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "pdfjs-dist": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.4.3",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  }
}
